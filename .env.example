# Copy this file to .env and fill in real values. .env is gitignored.

# Flask secret key used to sign sessions/cookies. Generate a random value,
# e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY = 'change-me'

# Schema the application operates under. Default: magic_stats_owner
DB_SCHEMA=magic_stats_owner

# Production/primary database connection string.
# The application connects as the magic_stats_owner role.
DATABASE_URL=postgresql://magic_stats_owner:password@host:5432/dbname

# Local development database connection string. Used as the default restore
# target by scripts/restore_full_database.py so local dev work never runs
# against DATABASE_URL directly.
LOCAL_DATABASE_URL = 'postgresql://postgres:password@localhost:5432/magicwebstats_dev'

# Username for the personal stats page
PERSONAL_STATS_USERNAME=Niklas

# Optional: only needed if pg_dump/pg_restore/psql/createdb/dropdb are not on
# your PATH. On Windows this is typically:
# PG_BIN_DIR = 'C:\Program Files\PostgreSQL\18\bin'
